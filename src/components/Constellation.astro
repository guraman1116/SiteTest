---
// Constellation — 軌道付きの星・スクロール視差・遠近感
//
// 3つの奥行きレイヤー（遠景・中景・近景）を重ね、
// スクロール量に応じてそれぞれ異なる速度で動く。
// 視差は Lenis の scroll イベントで駆動（自前 rAF ループを廃止）。
// 密度とコントラストを抑え、本文の可読性を最優先する。
---

<div class="cosmos" aria-hidden="true">
  <!-- 遠景：ごく淡い微星（最も遅く動く） -->
  <div class="cosmos__layer cosmos__layer--far" data-speed="0.04">
    <svg class="cosmos__svg" preserveAspectRatio="xMidYMid slice"></svg>
  </div>

  <!-- 中景：十字の星と星座線 -->
  <div class="cosmos__layer cosmos__layer--mid" data-speed="0.10">
    <svg class="cosmos__svg" preserveAspectRatio="xMidYMid slice"></svg>
  </div>

  <!-- 近景：主星と軌道（最も速く動く） -->
  <div class="cosmos__layer cosmos__layer--near" data-speed="0.18">
    <svg class="cosmos__svg" preserveAspectRatio="xMidYMid slice"></svg>
  </div>
</div>

<style>
  .cosmos {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .cosmos__layer {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    will-change: transform;
  }

  .cosmos__svg {
    width: 100%;
    height: 100%;
  }

  /* ---------- レイヤーごとの濃度（奥ほど淡い・可読性優先で控えめ） ---------- */
  .cosmos__layer--far  { opacity: 0.22; }
  .cosmos__layer--mid  { opacity: 0.32; }
  .cosmos__layer--near { opacity: 0.42; }

  @media (prefers-reduced-motion: reduce) {
    .cosmos__layer { transform: none !important; }
    .cosmos__layer--far  { opacity: 0.18; }
    .cosmos__layer--mid  { opacity: 0.22; }
    .cosmos__layer--near { opacity: 0.28; }
  }
</style>

<!-- 動的に生成したSVG要素は Astro のスタイルスコープが効かないため、
     is:global で確実にスタイルを当てる -->
<style is:global>
  .cosmos__svg .star-dot    { fill: var(--ink); }
  .cosmos__svg .star-cross  { stroke: var(--ink); stroke-linecap: round; fill: none; }
  .cosmos__svg .star-spark  { fill: var(--ink); }
  .cosmos__svg .star-core   { fill: var(--ink); }
  .cosmos__svg .const-line  { stroke: var(--ink); stroke-width: 0.4; fill: none; }
  /* 軌道楕円：内側を塗らない（線のみ） */
  .cosmos__svg .orbit       { stroke: var(--ink); stroke-width: 0.4; fill: none; stroke-dasharray: 2 3; }
  .cosmos__svg .orbit-planet{ fill: var(--ink); }
</style>

<script>
  // ---------- 星座・軌道・視差 ----------
  const layers = document.querySelectorAll<HTMLElement>(".cosmos__layer");
  const svgs = document.querySelectorAll<SVGSVGElement>(".cosmos__svg");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const rand = (min: number, max: number) => min + Math.random() * (max - min);

  // 十字星のパス生成
  function crossStar(x: number, y: number, r: number): string {
    return `<line class="star-cross" x1="${x - r}" y1="${y}" x2="${x + r}" y2="${y}" stroke-width="0.5"/>
            <line class="star-cross" x1="${x}" y1="${y - r}" x2="${x}" y2="${y + r}" stroke-width="0.5"/>`;
  }

  // 四つ星（菱形）のパス生成
  function sparkStar(x: number, y: number, r: number): string {
    const pts = `${x},${y - r} ${x + r * 0.35},${y} ${x},${y + r} ${x - r * 0.35},${y}`;
    return `<polygon class="star-spark" points="${pts}"/>`;
  }

  // 軌道付きの主星を生成
  function orbitSystem(x: number, y: number, scale: number, angle: number): string {
    const rx = 26 * scale;
    const ry = 9 * scale;
    const orbit = `<ellipse class="orbit" cx="${x}" cy="${y}" rx="${rx}" ry="${ry}" transform="rotate(${angle} ${x} ${y})"/>`;
    const t = rand(0, Math.PI * 2);
    const px = x + Math.cos(t) * rx;
    const py = y + Math.sin(t) * ry;
    const rad = (angle * Math.PI) / 180;
    const dx = px - x;
    const dy = py - y;
    const rx2 = x + dx * Math.cos(rad) - dy * Math.sin(rad);
    const ry2 = y + dx * Math.sin(rad) + dy * Math.cos(rad);
    const planet = `<circle class="orbit-planet" cx="${rx2}" cy="${ry2}" r="1"/>`;
    const main = sparkStar(x, y, 3.2 * scale) + `<circle class="star-core" cx="${x}" cy="${y}" r="0.8"/>`;
    return orbit + planet + main;
  }

  type Star = { x: number; y: number; size: number; phase: number };

  function buildLayer(svg: SVGSVGElement, index: number) {
    const w = window.innerWidth;
    const h = window.innerHeight;
    const layerH = h * 1.2;
    svg.setAttribute("viewBox", `0 0 ${w} ${layerH}`);

    let content = "";

    if (index === 0) {
      // ---- 遠景：微星のみ（点）— 密度を控えめに ----
      const count = Math.min(60, Math.floor((w * h) / 24000));
      for (let i = 0; i < count; i++) {
        const x = rand(0, w);
        const y = rand(0, layerH);
        const r = rand(0.4, 1);
        content += `<circle class="star-dot" cx="${x}" cy="${y}" r="${r}" data-phase="${rand(0, Math.PI * 2)}"/>`;
      }
    } else if (index === 1) {
      // ---- 中景：十字星 ＋ 星座線 ----
      const count = Math.min(16, Math.floor((w * h) / 95000));
      const stars: Star[] = [];
      for (let i = 0; i < count; i++) {
        stars.push({
          x: rand(w * 0.05, w * 0.95),
          y: rand(0, layerH),
          size: rand(3, 6),
          phase: rand(0, Math.PI * 2),
        });
      }
      // 星座線（近傍を最大2本結ぶ）
      const maxDist = 220;
      for (let i = 0; i < stars.length; i++) {
        const cands: { j: number; d: number }[] = [];
        for (let j = 0; j < stars.length; j++) {
          if (i === j) continue;
          const dx = stars[i].x - stars[j].x;
          const dy = stars[i].y - stars[j].y;
          const d = Math.hypot(dx, dy);
          if (d < maxDist) cands.push({ j, d });
        }
        cands.sort((a, b) => a.d - b.d);
        for (const c of cands.slice(0, 2)) {
          if (c.j > i) {
            content += `<line class="const-line" x1="${stars[i].x}" y1="${stars[i].y}" x2="${stars[c.j].x}" y2="${stars[c.j].y}"/>`;
          }
        }
      }
      for (const s of stars) {
        content += crossStar(s.x, s.y, s.size);
        content += `<circle class="star-core" cx="${s.x}" cy="${s.y}" r="0.9"/>`;
      }
    } else {
      // ---- 近景：軌道付きの主星 ----
      const count = Math.min(4, Math.max(2, Math.floor(w / 520)));
      for (let i = 0; i < count; i++) {
        const x = rand(w * 0.1, w * 0.9);
        const y = rand(layerH * 0.1, layerH * 0.9);
        const scale = rand(0.9, 1.7);
        const angle = rand(-35, 35);
        content += orbitSystem(x, y, scale, angle);
      }
    }

    svg.innerHTML = content;
  }

  function init() {
    svgs.forEach((svg, i) => buildLayer(svg, i));
  }

  init();

  let resizeTimer: number | undefined;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(init, 200);
  });

  // ---------- スクロール視差（Lenis または scroll で駆動）----------
  // Lenis が初期化されていればその 'scroll' イベント、
  // なければ window の scroll を使う。自前 rAF ループは廃止。
  const applyParallax = (scrollY: number) => {
    layers.forEach((layer) => {
      const speed = parseFloat(layer.dataset.speed || "0");
      layer.style.transform = `translate3d(0, ${-scrollY * speed}px, 0)`;
    });
  };

  if (!reduceMotion) {
    // Lenis のインスタンスを待ち受け取る（index.astro で window に設定）
    const lenis = (window as any).__lenis;
    if (lenis) {
      lenis.on("scroll", (e: { scroll: number }) => applyParallax(e.scroll));
    } else {
      window.addEventListener(
        "scroll",
        () => applyParallax(window.scrollY),
        { passive: true }
      );
    }
    applyParallax(window.scrollY);
  }

  // ---------- 控えめな瞬き（微星のみ）----------
  if (!reduceMotion) {
    const farDots = svgs[0]?.querySelectorAll<SVGCircleElement>(".star-dot");
    if (farDots && farDots.length) {
      const twinkle = () => {
        const t = performance.now() / 1000;
        farDots.forEach((el) => {
          const phase = parseFloat(el.dataset.phase || "0");
          const tw = 0.6 + 0.4 * Math.sin(t * 0.7 + phase);
          el.setAttribute("opacity", String(tw));
        });
        requestAnimationFrame(twinkle);
      };
      twinkle();
    }
  }
</script>
