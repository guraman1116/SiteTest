---
// Features — 選ばれる理由（2カラム組版）
const features = [
  {
    no: "i.",
    title: "伴走型の支援",
    desc: "ヒアリングから設計、開発、運用まで。一方的な発注ではなく、チームの一員として事業の成長を長く支えます。開発終了後も、月一度の定例で伴走を続けています。",
  },
  {
    no: "ii.",
    title: "速さと確かさ",
    desc: "初回提案は二営業日以内。まずは動くものをお見せし、小さく検証しながら最適な形へ近づけます。要件が固まらないうちから、一緒に形を探せます。",
  },
  {
    no: "iii.",
    title: "技術と品質",
    desc: "TypeScript を前提とし、CI 上でテストとレビューを必ず通す工程を組んでいます。引継ぎ用のドキュメントも納品するので、運用開始後も安心です。",
  },
  {
    no: "iv.",
    title: "デザインへの志",
    desc: "使う人が自然と戻ってくる体験をつくる。ブランドの価値を損なわない UI/UX 設計と、細部まで磨き上げた視覚表現に妥協しません。",
  },
];
---

<section class="section section--bordered features" id="features">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-head__no">§ 03 — Philosophy</span>
      <div class="section-head__body">
        <h2 class="section-title">信頼は、積み重ねでしかできない。</h2>
        <p class="section-subtitle">
          技術力と伴走の姿勢で、お客様のプロダクトを長く、確実に成功へ導きます。
        </p>
      </div>
    </div>

    <div class="features-grid">
      {
        features.map((f, i) => (
          <article class="feature reveal" data-delay={(i % 2) + 1}>
            <span class="feature__no">{f.no}</span>
            <h3 class="feature__title">{f.title}</h3>
            <p class="feature__desc">{f.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .feature {
    padding: clamp(32px, 4vw, 48px);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background 0.4s var(--ease);
  }
  .feature:hover {
    background: var(--paper-soft);
  }

  .feature__no {
    display: block;
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--ink-4);
    letter-spacing: 0.08em;
    margin-bottom: 20px;
  }

  .feature__title {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    margin-bottom: 14px;
    line-height: 1.5;
  }

  .feature__desc {
    color: var(--ink-2);
    font-size: 0.94rem;
    line-height: 1.9;
    letter-spacing: 0.04em;
    max-width: 440px;
  }

  @media (max-width: 720px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
