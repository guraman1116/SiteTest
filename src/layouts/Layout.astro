---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "COSMIC STUDIO — Web・アプリ・AI のシステム開発スタジオ（東京）",
  description = "Web サイト制作・アプリ開発・AI・業務自動化。企画から設計、開発、運用まで一貫して伴走する、東京の中目黒にあるシステム開発スタジオ。初回相談は無料、2 営業日以内にご提案。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1eeec" />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- フォント：明朝体（本文・Shippori Mincho を主軸に使用）＋ ゴシック（UI）＋ 等幅（ノート） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600;700&family=Noto+Serif+JP:wght@300;400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "COSMIC STUDIO",
      description: description,
      url: "https://cosmic-studio.jp",
      foundingDate: "2018",
      address: {
        "@type": "PostalAddress",
        addressLocality: "目黒区",
        addressRegion: "東京都",
        addressCountry: "JP",
      },
      email: "hello@cosmic-studio.jp",
      telephone: "+81-3-1234-5678",
      knowsAbout: ["Webサイト制作", "アプリ開発", "AI・業務自動化"],
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
